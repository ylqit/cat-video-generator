{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cat-video-generator.local/schemas/daily-life-pack.schema.json",
  "title": "DailyLifePackV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lifePackId",
    "date",
    "timezone",
    "dayContext",
    "planRevision",
    "status",
    "slots",
    "fallbackEpisodes",
    "externalSignalIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "lifePackId": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "const": "Asia/Shanghai"
    },
    "dayContext": {
      "$ref": "#/$defs/dayContext"
    },
    "planRevision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "candidate",
        "approved",
        "frozen",
        "rendering",
        "ready",
        "delivered",
        "failed"
      ]
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "morning",
        "noon",
        "evening"
      ],
      "properties": {
        "morning": {
          "allOf": [
            {
              "$ref": "episode-spec.schema.json"
            },
            {
              "properties": {
                "slot": {
                  "const": "morning"
                }
              }
            }
          ]
        },
        "noon": {
          "allOf": [
            {
              "$ref": "episode-spec.schema.json"
            },
            {
              "properties": {
                "slot": {
                  "const": "noon"
                }
              }
            }
          ]
        },
        "evening": {
          "allOf": [
            {
              "$ref": "episode-spec.schema.json"
            },
            {
              "properties": {
                "slot": {
                  "const": "evening"
                }
              }
            }
          ]
        }
      }
    },
    "fallbackEpisodes": {
      "type": "array",
      "items": {
        "$ref": "episode-spec.schema.json"
      }
    },
    "externalSignalIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "dayContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextType",
        "theme",
        "locationCluster",
        "weather",
        "wardrobeVersionIds",
        "availableProps",
        "sharedMood"
      ],
      "properties": {
        "contextType": {
          "enum": [
            "travel",
            "home",
            "outing",
            "festival",
            "everyday"
          ]
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "locationCluster": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "allowedLocationIds"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "allowedLocationIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        },
        "weather": {
          "type": "string",
          "minLength": 1
        },
        "wardrobeVersionIds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "person",
            "cat"
          ],
          "properties": {
            "person": {
              "type": "string",
              "minLength": 1
            },
            "cat": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "availableProps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sharedMood": {
          "type": "string",
          "minLength": 1
        },
        "chapterId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
