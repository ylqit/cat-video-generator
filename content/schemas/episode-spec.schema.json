{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cat-video-generator.local/schemas/episode-spec.schema.json",
  "title": "EpisodeSpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "episodeId",
    "lifePackId",
    "slot",
    "title",
    "logline",
    "durationMs",
    "clipKind",
    "visualControl",
    "continuityMode",
    "dependsOnEpisodeIds",
    "contextReads",
    "stateWrites",
    "fallbackEpisodeId",
    "beats",
    "requiredSubjectVersionIds",
    "styleVersionId",
    "forbiddenContent",
    "sourceSignalIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "episodeId": {
      "type": "string",
      "minLength": 1
    },
    "lifePackId": {
      "type": "string",
      "minLength": 1
    },
    "slot": {
      "enum": [
        "morning",
        "noon",
        "evening"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "logline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "durationMs": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 15000,
      "multipleOf": 1000
    },
    "clipKind": {
      "enum": [
        "observation",
        "micro_event",
        "continuation"
      ]
    },
    "visualControl": {
      "$ref": "#/$defs/visualControl"
    },
    "continuityMode": {
      "enum": [
        "shared_context",
        "follows_previous"
      ]
    },
    "dependsOnEpisodeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contextReads": {
      "$ref": "#/$defs/contextReads"
    },
    "stateWrites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stateWrite"
      }
    },
    "fallbackEpisodeId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "beats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/beat"
      }
    },
    "requiredSubjectVersionIds": {
      "type": "array",
      "prefixItems": [
        {
          "const": "person-v1"
        },
        {
          "const": "cat-v1"
        }
      ],
      "items": false
    },
    "styleVersionId": {
      "const": "storybook-pencil-v1"
    },
    "forbiddenContent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sourceSignalIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "continuityMode": {
            "const": "follows_previous"
          }
        }
      },
      "then": {
        "properties": {
          "clipKind": {
            "const": "continuation"
          },
          "dependsOnEpisodeIds": {
            "minItems": 1
          },
          "fallbackEpisodeId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "clipKind": {
            "enum": [
              "observation",
              "micro_event"
            ]
          },
          "dependsOnEpisodeIds": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "visualControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiresExactOpening",
        "requiresExactEnding",
        "complexSubjectInteraction",
        "criticalPropState"
      ],
      "properties": {
        "requiresExactOpening": {
          "type": "boolean"
        },
        "requiresExactEnding": {
          "type": "boolean"
        },
        "complexSubjectInteraction": {
          "type": "boolean"
        },
        "criticalPropState": {
          "type": "boolean"
        }
      }
    },
    "contextReads": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locationId",
        "locationClusterId",
        "weather",
        "wardrobeVersionIds",
        "propIds",
        "sharedMood"
      ],
      "properties": {
        "locationId": {
          "type": "string",
          "minLength": 1
        },
        "locationClusterId": {
          "type": "string",
          "minLength": 1
        },
        "weather": {
          "type": "string",
          "minLength": 1
        },
        "wardrobeVersionIds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "person",
            "cat"
          ],
          "properties": {
            "person": {
              "type": "string",
              "minLength": 1
            },
            "cat": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "propIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sharedMood": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stateWrite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "operation",
        "path",
        "value",
        "approvalStatus"
      ],
      "properties": {
        "scope": {
          "enum": [
            "day",
            "canon"
          ]
        },
        "operation": {
          "enum": [
            "add",
            "replace",
            "retire"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "value": {},
        "approvalStatus": {
          "enum": [
            "not_required",
            "preapproved"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "canon"
              }
            }
          },
          "then": {
            "properties": {
              "approvalStatus": {
                "const": "preapproved"
              }
            }
          },
          "else": {
            "properties": {
              "approvalStatus": {
                "const": "not_required"
              }
            }
          }
        }
      ]
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "startMs",
        "endMs",
        "purpose",
        "visualAction",
        "actors",
        "sfx"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14999
        },
        "endMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15000
        },
        "purpose": {
          "enum": [
            "establish",
            "activity",
            "interaction",
            "discovery",
            "reaction",
            "turn",
            "result",
            "linger"
          ]
        },
        "visualAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "actors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "person",
              "cat",
              "environment"
            ]
          },
          "uniqueItems": true
        },
        "emotion": {
          "type": "string",
          "maxLength": 40
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "optionalSubtitle": {
          "type": "string",
          "maxLength": 16
        }
      }
    }
  }
}
