{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cat-video-generator.local/schemas/trend-signal.schema.json",
  "title": "TrendSignalV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "signalId",
    "sourceType",
    "sourceUrl",
    "collectedAt",
    "expiresAt",
    "theme",
    "emotion",
    "audienceNeed",
    "lifeSituation",
    "visualMotifs",
    "editorialStatus",
    "containsRawQuote",
    "containsPersonalData"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "signalId": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "enum": [
        "editorial",
        "calendar",
        "weather",
        "xiaohongshu_manual_link"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "theme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "emotion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "audienceNeed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "lifeSituation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "visualMotifs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "uniqueItems": true
    },
    "editorialStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ]
    },
    "containsRawQuote": {
      "const": false
    },
    "containsPersonalData": {
      "const": false
    },
    "reviewNote": {
      "type": "string",
      "maxLength": 240
    }
  }
}
