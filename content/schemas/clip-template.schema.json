{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cat-video-generator.local/schemas/clip-template.schema.json",
  "title": "ClipTemplateV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateId",
    "clipKind",
    "continuityMode",
    "requiresDependency",
    "allowedSlots",
    "beatPattern",
    "cooldownDays",
    "invariants",
    "forbiddenPatterns"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "templateId": {
      "type": "string",
      "minLength": 1
    },
    "clipKind": {
      "enum": [
        "observation",
        "micro_event",
        "continuation"
      ]
    },
    "continuityMode": {
      "enum": [
        "shared_context",
        "follows_previous"
      ]
    },
    "requiresDependency": {
      "type": "boolean"
    },
    "allowedSlots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "morning",
          "noon",
          "evening"
        ]
      },
      "uniqueItems": true
    },
    "beatPattern": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "enum": [
          "establish",
          "activity",
          "interaction",
          "discovery",
          "reaction",
          "turn",
          "result",
          "linger"
        ]
      }
    },
    "cooldownDays": {
      "type": "integer",
      "minimum": 1
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbiddenPatterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "clipKind": {
            "const": "continuation"
          }
        }
      },
      "then": {
        "properties": {
          "continuityMode": {
            "const": "follows_previous"
          },
          "requiresDependency": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "continuityMode": {
            "const": "shared_context"
          },
          "requiresDependency": {
            "const": false
          }
        }
      }
    }
  ]
}
