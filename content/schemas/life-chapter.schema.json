{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cat-video-generator.local/schemas/life-chapter.schema.json",
  "title": "LifeChapterV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chapterId",
    "title",
    "contextType",
    "startDate",
    "endDate",
    "theme",
    "locationClusterIds",
    "wardrobeVersionIds",
    "recurringProps",
    "moodRange",
    "contentLanes",
    "dailyContextHints"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "chapterId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "contextType": {
      "enum": [
        "travel",
        "home",
        "outing",
        "festival",
        "everyday"
      ]
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "endDate": {
      "type": "string",
      "format": "date"
    },
    "theme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "locationClusterIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "wardrobeVersionIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person",
        "cat"
      ],
      "properties": {
        "person": {
          "type": "string",
          "minLength": 1
        },
        "cat": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recurringProps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "moodRange": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "contentLanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "observation",
          "micro_event",
          "continuation"
        ]
      },
      "uniqueItems": true
    },
    "dailyContextHints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dailyContextHint"
      }
    }
  },
  "$defs": {
    "dailyContextHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "theme",
        "suggestedLocationIds",
        "sharedMood"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "theme": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "suggestedLocationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sharedMood": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
