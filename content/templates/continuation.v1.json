{
  "schemaVersion": 1,
  "templateId": "continuation-v1",
  "clipKind": "continuation",
  "continuityMode": "follows_previous",
  "requiresDependency": true,
  "allowedSlots": [
    "noon",
    "evening"
  ],
  "beatPattern": [
    "establish",
    "activity",
    "result",
    "linger"
  ],
  "cooldownDays": 3,
  "invariants": [
    "dependency-is-explicit-and-selected-for-delivery",
    "dependency-facts-are-visually-reintroduced",
    "fallback-is-independent-and-same-context",
    "undelivered-state-is-never-assumed"
  ],
  "forbiddenPatterns": [
    "missing-fallback",
    "dependency-on-future-slot",
    "undelivered-event-reference",
    "identity-change",
    "hard-cliffhanger"
  ]
}
