# API
#ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Agent_Plan
ARK_ACCESS_MODE=standard
ARK_AGENT_PLAN_TIER=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 调用文本模型思考推理剧本内容
ARK_PLANNING_MODEL=doubao-seed-2-1-pro-260628
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
# Video model selection (use an API model ID, not the console display label)
# ARK_VIDEO_MODEL=doubao-seedance-2.0-mini
# ARK_VIDEO_MODEL=doubao-seedance-2-0-mini-260615
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
# 救援卡死的run：改为整集一次性生成（single_pass），绕开会卡死的逐镜头诊断门。
# 若要恢复逐镜头模式改回 per_shot（需先修复 _shot_clip 复用查询 bug）。
ARK_VIDEO_GENERATION_MODE=single_pass
ARK_VIDEO_RESOLUTION=480p
ARK_POLL_INTERVAL_SECONDS=10
ARK_TASK_TIMEOUT_SECONDS=1800
FFMPEG_PATH=C:\Users\wwwab\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1.2-full_build\bin\ffmpeg.exe
